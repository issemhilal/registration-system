<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Unique Academy</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>

  <header>
   <h1>UNIQUE ACADEMY</h1> 
  </header>

  <nav>
    <button data-tab="home">Home</button>
    <button data-tab="registration">Student Registration</button>
    <button data-tab="records">Student Records</button>
  </nav>

  <main>
    <section id="home" class="tab">
      <h2>Welcome to Unique Academy</h2>
      <p>Register students and view their academic results in one place.</p>
    </section>

    <section id="registration" class="tab">
      <h2>Student Registration</h2>
      <div id="message"></div>

      <form id="studentForm">
        <label for="fullName">Student Full Name</label>
        <input type="text" id="fullName">

        <label for="regNumber">Registration Number</label>
        <input type="text" id="regNumber">

        <label for="gender">Gender</label>
        <select id="gender">
          <option value="">-- Select gender --</option>
          <option value="Male">Male</option>
          <option value="Female">Female</option>
          <option value="Other">Other</option>
        </select>

        <label for="course">Course Name</label>
        <input type="text" id="course">

        <label for="subject1">Subject 1 (0-100)</label>
        <input type="number" id="subject1" min="0" max="100">

        <label for="subject2">Subject 2 (0-100)</label>
        <input type="number" id="subject2" min="0" max="100">

        <label for="subject3">Subject 3 (0-100)</label>
        <input type="number" id="subject3" min="0" max="100">

        <button type="submit" class="submit-btn">Register Student</button>
      </form>
    </section>

    <section id="records" class="tab">
      <h2>Student Records</h2>
      <p>Total registered students: <strong id="studentCount">0</strong></p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>S/N</th>
              <th>Student Name</th>
              <th>Registration No.</th>
              <th>Course</th>
              <th>Total</th>
              <th>Average</th>
              <th>Grade</th>
            </tr>
          </thead>
          <tbody id="recordsBody"></tbody>
        </table>
      </div>
    </section>
  </main>

  <script src="script.js"></script>
</body>
</html>

* {
  box-sizing: border-box;
}

/* Graph paper background */
body {
  margin: 0;
  font-family: Verdana, Geneva, sans-serif;
  color: #1c2b27;
  background-color: #eef3ec;
  background-image:
    linear-gradient(#cfdccf 1px, transparent 1px),
    linear-gradient(90deg, #cfdccf 1px, transparent 1px);
  background-size: 24px 24px;
}

/* Chalkboard header */
header {
  background: #0f3d3e;
  color: #f4efd8;
  text-align: center;
  padding: 28px 15px 22px;
  border-bottom: 6px solid #d4a017;
}

header h1 {
  margin: 0;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 34px;
  letter-spacing: 6px;
}

/* Navigation as folder tabs */
nav {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  max-width: 800px;
  margin: 24px auto 0;
  padding: 0 15px;
}

nav button {
  background: #cfdccf;
  color: #0f3d3e;
  border: 2px solid #0f3d3e;
  border-bottom: none;
  border-radius: 12px 12px 0 0;
  padding: 10px 16px;
  font-family: Georgia, serif;
  font-size: 16px;
  font-weight: bold;
  cursor: pointer;
}

nav button:hover {
  background: #e3ecd9;
}

nav button.active {
  background: #ffffff;
  position: relative;
  top: 2px;
  box-shadow: 0 -4px 0 #d4a017 inset;
}

main {
  max-width: 800px;
  margin: 0 auto 30px;
  padding: 0 15px;
}

/* Tabs: hidden by default, only the active one shows */
.tab {
  display: none;
  background: #ffffff;
  padding: 24px;
  border: 2px solid #0f3d3e;
  border-radius: 0 14px 14px 14px;
}

.tab.active {
  display: block;
}

h2 {
  font-family: Georgia, serif;
  color: #0f3d3e;
  margin-top: 0;
  padding-bottom: 8px;
  border-bottom: 3px double #d4a017;
}

/* Home tab */
#home {
  background: #0f3d3e;
  color: #f4efd8;
  text-align: center;
  padding: 50px 20px;
}

#home h2 {
  color: #d4a017;
  font-size: 30px;
  border-bottom: none;
}

#home p {
  font-size: 17px;
  line-height: 1.6;
}

#homePhoto {
  width: 150px;
  height: 150px;
  object-fit: cover;
  border-radius: 50%;
  border: 5px solid #d4a017;
  margin-bottom: 15px;
}

/* Form */
label {
  display: block;
  margin-top: 14px;
  font-weight: bold;
  color: #0f3d3e;
}

input, select {
  width: 100%;
  padding: 10px;
  margin-top: 5px;
  border: 2px solid #9fb5a8;
  border-radius: 6px;
  font-size: 16px;
  background: #fbfdf9;
}

input:focus, select:focus {
  outline: none;
  border-color: #d4a017;
  background: #fffdf2;
}

.submit-btn {
  margin-top: 22px;
  padding: 12px 24px;
  background: #d4a017;
  color: #0f3d3e;
  border: 2px solid #0f3d3e;
  border-radius: 6px;
  font-family: Georgia, serif;
  font-size: 17px;
  font-weight: bold;
  cursor: pointer;
  box-shadow: 4px 4px 0 #0f3d3e;
}

.submit-btn:hover {
  background: #e6b422;
}

.submit-btn:active {
  box-shadow: 1px 1px 0 #0f3d3e;
  transform: translate(3px, 3px);
}

/* Messages */
#message {
  padding: 12px;
  border-radius: 6px;
  display: none;
  font-weight: bold;
}

#message.success {
  display: block;
  background: #dff3e4;
  color: #14532d;
  border-left: 6px solid #22863a;
}

#message.error {
  display: block;
  background: #fde8e8;
  color: #7f1d1d;
  border-left: 6px solid #c53030;
}

/* Records table */
.table-wrap {
  overflow-x: auto;
}

table {
  width: 100%;
  border-collapse: collapse;
}

th, td {
  padding: 10px;
  text-align: left;
  border-bottom: 1px solid #cfdccf;
}

th {
  background: #0f3d3e;
  color: #f4efd8;
  font-family: Georgia, serif;
}

tbody tr:nth-child(even) {
  background: #f1f6ef;
}

tbody tr:hover {
  background: #fff6d6;
}

td:last-child {
  font-weight: bold;
  color: #0f3d3e;
}

/* Small screens */
@media (max-width: 500px) {
  header h1 {
    font-size: 24px;
    letter-spacing: 3px;
  }
  nav button {
    font-size: 14px;
    padding: 8px 10px;
  }
}


// Array that stores all student objects
const students = [];

// Get elements from the page
const form = document.getElementById("studentForm");
const message = document.getElementById("message");
const recordsBody = document.getElementById("recordsBody");
const studentCount = document.getElementById("studentCount");
const tabs = document.querySelectorAll(".tab");
const navButtons = document.querySelectorAll("nav button");

// Function: show one tab and hide the others
function showTab(tabId) {
  for (let i = 0; i < tabs.length; i++) {
    tabs[i].classList.remove("active");
  }
  for (let i = 0; i < navButtons.length; i++) {
    navButtons[i].classList.remove("active");
    if (navButtons[i].dataset.tab === tabId) {
      navButtons[i].classList.add("active");
    }
  }
  document.getElementById(tabId).classList.add("active");
  console.log("Showing tab:", tabId);
}

// Click events for the navigation buttons
for (let i = 0; i < navButtons.length; i++) {
  navButtons[i].addEventListener("click", function () {
    showTab(navButtons[i].dataset.tab);
  });
}

// Function: calculate total marks
function calculateTotal(s1, s2, s3) {
  return s1 + s2 + s3;
}

// Function: calculate average marks
function calculateAverage(total) {
  return total / 3;
}

// Function: determine grade
// NOTE: assumed grading system - change it to match your assignment
function determineGrade(average) {
  if (average >= 80) {
    return "A";
  } else if (average >= 70) {
    return "B";
  } else if (average >= 60) {
    return "C";
  } else if (average >= 50) {
    return "D";
  } else {
    return "F";
  }
}

// Function: random mark between 40 and 100
function randomMark() {
  return Math.floor(Math.random() * 61) + 40;
}

// Function: show a message (success or error)
function showMessage(text, type) {
  message.textContent = text;
  message.className = type;
}

// Function: register a new student
function registerStudent(name, regNo, gender, course, s1, s2, s3) {
  const total = calculateTotal(s1, s2, s3);
  const average = calculateAverage(total);
  const grade = determineGrade(average);

  const student = {
    name: name,
    regNo: regNo,
    gender: gender,
    course: course,
    total: total,
    average: average.toFixed(2),
    grade: grade
  };

  students.push(student);
  console.log("Student registered:", student);
}

// Function: display all students in the table
function displayStudents() {
  recordsBody.innerHTML = "";

  for (let i = 0; i < students.length; i++) {
    const s = students[i];
    recordsBody.innerHTML +=
      "<tr>" +
      "<td>" + (i + 1) + "</td>" +
      "<td>" + s.name + "</td>" +
      "<td>" + s.regNo + "</td>" +
      "<td>" + s.course + "</td>" +
      "<td>" + s.total + "</td>" +
      "<td>" + s.average + "</td>" +
      "<td>" + s.grade + "</td>" +
      "</tr>";
  }

  studentCount.textContent = students.length;
}

// When the form is submitted
form.addEventListener("submit", function (event) {
  event.preventDefault();

  const name = document.getElementById("fullName").value.trim();
  const regNo = document.getElementById("regNumber").value.trim();
  const gender = document.getElementById("gender").value;
  const course = document.getElementById("course").value.trim();
  const s1Text = document.getElementById("subject1").value;
  const s2Text = document.getElementById("subject2").value;
  const s3Text = document.getElementById("subject3").value;

  console.log("Form submitted");

  // Validation: missing information
  if (name === "" || regNo === "" || gender === "" || course === "" ||
      s1Text === "" || s2Text === "" || s3Text === "") {
    showMessage("Please fill in all fields.", "error");
    console.log("Validation failed: missing information");
    return;
  }

  const s1 = Number(s1Text);
  const s2 = Number(s2Text);
  const s3 = Number(s3Text);

  // Validation: marks must be between 0 and 100
  if (s1 < 0 || s1 > 100 || s2 < 0 || s2 > 100 || s3 < 0 || s3 > 100) {
    showMessage("Marks must be between 0 and 100.", "error");
    console.log("Validation failed: marks out of range");
    return;
  }

  // Validation: no duplicate registration numbers
  for (let i = 0; i < students.length; i++) {
    if (students[i].regNo === regNo) {
      showMessage("That registration number already exists.", "error");
      console.log("Validation failed: duplicate registration number");
      return;
    }
  }

  registerStudent(name, regNo, gender, course, s1, s2, s3);
  displayStudents();
  showMessage("Student registered successfully!", "success");
  form.reset();
});

// Five default students with random marks
registerStudent("Simon baker", "UA001", "Male", "Computer Science", randomMark(), randomMark(), randomMark());
registerStudent("Billy kimber", "UA002", "Male", "Software Engineering", randomMark(), randomMark(), randomMark());
registerStudent("Grace shelby", "UA003", "Female", "Information Technology", randomMark(), randomMark(), randomMark());
registerStudent("David goggins", "UA004", "Male", "computer science", randomMark(), randomMark(), randomMark());
registerStudent("Michael arteta", "UA005", "Male", "computer science", randomMark(), randomMark(), randomMark());

displayStudents();
showTab("home");
